{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xfreddy/very-very-very-good-swift-skill/schemas/build-benchmark.schema.json",
  "title": "Xcode Build Benchmark",
  "type": "object",
  "required": ["schema_version", "created_at", "command_contract", "environment", "results"],
  "properties": {
    "schema_version": { "const": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "command_contract": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "required": ["platform", "python", "xcodebuild"],
      "additionalProperties": { "type": "string" }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario", "runs", "summary"],
        "properties": {
          "scenario": { "enum": ["clean", "cached-clean", "zero-change", "incremental"] },
          "runs": { "type": "array", "minItems": 1 },
          "summary": {
            "type": "object",
            "required": ["median_seconds", "minimum_seconds", "maximum_seconds"],
            "properties": {
              "median_seconds": { "type": "number", "minimum": 0 },
              "minimum_seconds": { "type": "number", "minimum": 0 },
              "maximum_seconds": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
